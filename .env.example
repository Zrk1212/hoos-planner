# Supabase (project created with `supabase projects create`)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-only: used by scripts/ and the chat API, never shipped to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Catalog
DEFAULT_TERM=1272
# Secret header value the nightly sync job must send to /api/sync (optional)
SYNC_SECRET=
